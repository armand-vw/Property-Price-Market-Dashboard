.venv/
venv/
.git/
.github/
.gitignore
.pytest_cache/
__pycache__/
*.py[cod]
*.egg-info/

# Not needed at runtime
data/
docs/
assets/
tests/
scripts/
conftest.py
*.md
requirements-dev.txt
pyproject.toml
LICENSE
runtime.txt
